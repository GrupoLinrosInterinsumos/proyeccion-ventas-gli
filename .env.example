# Postgres connection string. Leave unset for local development — the app falls back to an
# embedded Postgres-compatible database stored in ./data (no external service required).
# On Render, this is provided automatically when the web service is linked to the database
# (see render.yaml).
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Signs the login session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
