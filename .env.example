# Postgres connection string. Leave unset for local development — the app falls back to an
# embedded Postgres-compatible database stored in ./data (no external service required).
# On Render, this is provided automatically when the web service is linked to the database
# (see render.yaml).
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Signs the login session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Clave para que el robot del reporte de cobertura de stock (Agente-correos) descargue
# /api/export-cobertura sin iniciar sesión. Debe ser el mismo valor que PROYECCION_TOKEN en el
# .env del robot. Sin esta variable, la exportación solo funciona con sesión de administrador.
# EXPORT_TOKEN=
